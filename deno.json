{
  "tasks": {
    "build": "deno run -A ./config/build.ts",
    "build:watch": "deno run -A ./config/build.ts --watch",
    "build:dev": "deno run -A ./config/build.ts --develop",
    "build:dev:watch": "deno run -A ./config/build.ts --develop --watch",
    "lint": "deno lint",
    "test": "deno test -A --check --reload --doc --allow-none --junit-path=\"./report.xml\""
  },
  "exclude": [
    "./worker/"
  ],
  "test": {
    "include": [
      "**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "lib": [
      "ES6",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-sparse-arrays",
        "prefer-ascii",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-inferrable-types"
      ]
    }
  }
}
